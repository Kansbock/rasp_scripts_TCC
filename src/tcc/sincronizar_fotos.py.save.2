import requests
import base64
import os
import time
import subprocess
import concurrent.futures
import threading
from datetime import datetime
from pathlib import Path
from dotenv import load_dotenv

load_dotenv()

# Configurações do barramento USB (Raspberry Pi 3B+)
USB_BUS = '1-1'
USB_DRIVER_DIR = "/sys/bus/usb/drivers/usb"
MAX_THREADS = 5  # Limite de envios simultâneos (Seguro para a RAM do RPi 3B+)

# Sinalizador global para abortar o envio em caso de queda de rede
abortar_envio = threading.Event()

def is_usb_ligado():
    """Verifica se o barramento USB está montado (ligado) no sistema."""
    return os.path.exists(os.path.join(USB_DRIVER_DIR, USB_BUS))

def ligar_usb():
    """Liga as portas USB usando sudo para ter privilégio."""
    try:
        comando = f"echo '{USB_BUS}' | sudo tee {os.path.join(USB_DRIVER_DIR, 'bind')} > /dev/null"
        subprocess.run(comando, shell=True, check=True)
        print("Entradas USB LIGADAS.")
    except Exception as e:
        print(f"Erro ao ligar USB: {e}")

def desligar_usb():
    """Desliga as portas USB usando sudo para ter privilégio."""
    try:
        comando = f"echo '{USB_BUS}' | sudo tee {os.path.join(USB_DRIVER_DIR, 'unbind')} > /dev/null"
        subprocess.run(comando, shell=True, check=True)
        print("Entradas USB DESLIGADAS.")
    except Exception as e:
        print(f"Erro ao desligar USB: {e}")

def ligar_tailscale():
    """Inicia o serviço do Tailscale com sudo."""
    print("Iniciando/Reiniciando serviço Tailscale...")
    try:
        subprocess.run(["sudo", "systemctl", "restart", "tailscaled"])
        time.sleep(2)
        subprocess.run(["sudo", "tailscale", "up"])
        print("Tailscale iniciado com sucesso.")
    except Exception as e:
        print(f"Erro ao iniciar Tailscale: {e}")

def is_tailscale_ligado():
    """Verifica se o serviço do Tailscale está ativo E conectado, com timeout de segurança."""
    try:
        # 1. Verifica se o serviço base do sistema está rodando
        daemon_check = subprocess.run(
            ["systemctl", "is-active", "tailscaled"],
            capture_output=True, text=True
        )
        if daemon_check.stdout.strip() != "active":
            return False
            
        # 2. Verifica o status real (Juntando stdout e stderr)
        status_check = subprocess.run(
            ["sudo", "tailscale", "status"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, # Captura mensagens de erro e alertas do sistema
            text=True,
            timeout=10 # Se o comando travar por 10 seg, assumimos que a rede caiu
        )
        
        status_out = status_check.stdout.lower()
        
        # Se aparecer alguma dessas palavras, a conexão caiu
        if "stopped" in status_out or "logged out" in status_out or "offline" in status_out:
            return False
            
        return True
    except subprocess.TimeoutExpired:
        print("-> Comando do Tailscale travou (Timeout). Assumindo queda.")
        return False
    except Exception as e:
        print(f"Erro ao verificar Tailscale: {e}")
        return False

def processar_uma_foto(arquivo, url, api_key):
    """Função executada por cada Thread individualmente."""
    # Se alguma outra thread detectou queda de rede, nem tenta processar a próxima
    if abortar_envio.is_set():
        return False

    try:
        with open(arquivo, "rb") as image_file:
            encoded_string = base64.b64encode(image_file.read()).decode('utf-8')

        payload = {
            "image_data": encoded_string,
            "file_name": arquivo.name
        }
        headers = {"x-api-key": api_key, "Content-Type": "application/json"}

        # Timeout de 15 segundos evita travamentos quando a internet/VPN pisca
        response = requests.post(url, json=payload, headers=headers, timeout=15)

        if response.status_code == 200:
            print(f"Sucesso: {arquivo.name} enviado (Thread: {threading.current_thread().name})")
            arquivo.unlink()
            return True
        else:
            print(f"Erro ao enviar {arquivo.name}: Status {response.status_code}")
            return False

    except requests.exceptions.RequestException as e:
        print(f"\n[!] Falha de rede detectada no arquivo {arquivo.name}")
        # Ativa o sinal de abortar para parar todas as outras threads e acionar a auto-cura
        abortar_envio.set()
        return False

    except Exception as e:
        print(f"Falha local crítica no arquivo {arquivo.name}: {e}")
        return False

def enviar_e_apagar_fotos(pasta_origem):
    url = "https://7o79fzgdc0.execute-api.us-east-1.amazonaws.com/prod/upload"
    api_key = os.getenv('API_KEY')
    origem = Path(pasta_origem)

    # Filtra apenas arquivos .jpg e .jpeg
    arquivos = list(origem.glob("*.jpg")) + list(origem.glob("*.jpeg"))

    if not arquivos:
        return

    print(f"\nEncontradas {len(arquivos)} fotos. Iniciando envio PARALELO ({MAX_THREADS} por vez)...")
    
    # Limpa o sinalizador de abortar antes de começar um novo lote
    abortar_envio.clear()

    # Cria um pool de threads limitando a quantidade simultânea
    with concurrent.futures.ThreadPoolExecutor(max_workers=MAX_THREADS) as executor:
        # Envia as tarefas para o pool
        futures = [executor.submit(processar_uma_foto, arquivo, url, api_key) for arquivo in arquivos]
        
        # Aguarda a conclusão das tarefas ativas (mas sem adicionar novas se abortar_envio estiver ativado)
        concurrent.futures.wait(futures)

    if abortar_envio.is_set():
        print("Lote interrompido precocemente devido a falhas de rede. Restante aguardando o próximo ciclo.")
    else:
        print("Lote de envio finalizado com sucesso.")

# === INÍCIO DO PROGRAMA PRINCIPAL ===

pasta_fotos = Path.home() / "fotos"
print(f"Monitorando a pasta: {pasta_fotos}")
print("Sistema de automação iniciado (USB, Tailscale Auto-Cura e Paralelismo).")

# Variável para rastrear se a rede caiu no ciclo anterior
falha_rede_recente = False

while True:
    hora_atual = datetime.now().hour
    horario_formatado = time.strftime('%H:%M:%S')

    # Verifica se a hora está entre 12:00 e 20:59
    if 12 <= hora_atual < 18:
        print(f"[{horario_formatado}] Dentro do horário de envio (12h-21h).")

        # AUTO-CURA: Se o ciclo anterior detectou queda de internet (timeout na AWS)
        if falha_rede_recente:
            print(f"\n[!] Sistema de Auto-Cura acionado!")
            print("Limpando rotas presas e forçando reinício do Tailscale...")
            ligar_tailscale() # O ligar_tailscale já dá o 'systemctl restart'
            falha_rede_recente = False # Reseta o alarme
            print("Aguardando 15 segundos para a rede estabilizar...\n")
            time.sleep(15)

        # O USB está desligado?
        if not is_usb_ligado():
            ligar_usb()
            print("Aguardando 5 minutos para estabilização de hardware e rede...")
            time.sleep(300) # Pausa de 5 minutos (300 segundos)
            ligar_tailscale()

        # O USB já está ligado?
        else:
            if not is_tailscale_ligado():
                print(f"[{horario_formatado}] Tailscale inativo ou travado. Reiniciando...")
                ligar_tailscale()

        # Segue o fluxo paralelo de enviar fotos
        enviar_e_apagar_fotos(pasta_fotos)
        
        # Se a thread ativou o sinal de abortar, a internet/VPN caiu durante o envio
        if abortar_envio.is_set():
            falha_rede_recente = True # Aciona o alarme de auto-cura para o próximo ciclo

    # Fora do horário (21:00 às 11:59)
    else:
        # Se os USBs ainda estiverem ligados, desliga
        if is_usb_ligado():
            print(f"[{horario_formatado}] Fora do horário. Desligando USBs...")
            desligar_usb()
        else:
            print(f"[{horario_formatado}] Modo de economia: USBs já estão desligados.")

    # Pausa antes do próximo ciclo de checagem principal
    print("Aguardando 60 segundos para a próxima checagem global...\n")
    time.sleep(60)
